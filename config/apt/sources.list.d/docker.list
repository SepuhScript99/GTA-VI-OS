# GTA VI OS (Vice OS) APT Source for Docker Engine
# NOTE: This file is NOT installed during chroot build. The app installer
# (apps/vp-docker.sh) regenerates it dynamically with the correct architecture.
# The GPG key is installed by apps/vp-docker.sh to /etc/apt/keyrings/docker.gpg

deb [arch=amd64 signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian bookworm stable