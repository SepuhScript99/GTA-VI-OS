# GTA VI OS (Vice OS) Openbox-3 Theme — Vice-Dark (Leonida Coastal Dusk)
# Calm slate-midnight window frames with crisp structural hairlines, rounded-compositor
# friendly titlebar padding, and sunset accents.

# --- Window Geometry & Typography ---
border.width: 1
padding.width: 12
padding.height: 8
window.client.padding.width: 0
window.client.padding.height: 0
window.handle.width: 2

window.label.text.justify: left

# --- Active Window ---
window.active.border.color: #3B425E
window.active.client.color: #0D0E15
window.active.title.bg: flat solid
window.active.title.bg.color: #141621
window.active.title.separator.color: #2C3147

window.active.label.bg: parentrelative
window.active.label.text.color: #F5F6FA

window.active.handle.bg: flat solid
window.active.handle.bg.color: #141621
window.active.grip.bg: flat solid
window.active.grip.bg.color: #3B425E

# Active Buttons
window.active.button.unpressed.bg: parentrelative
window.active.button.unpressed.image.color: #A6AEBF

window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #23273A
window.active.button.hover.image.color: #FF9A62
window.active.button.close.hover.bg: flat solid
window.active.button.close.hover.bg.color: #3B1D26
window.active.button.close.hover.image.color: #F25C6E

window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #2B2230
window.active.button.pressed.image.color: #FF5E7E
window.active.button.close.pressed.image.color: #FF5E7E

window.active.button.toggled.unpressed.bg: parentrelative
window.active.button.toggled.unpressed.image.color: #FF5E7E
window.active.button.toggled.hover.bg: flat solid
window.active.button.toggled.hover.bg.color: #23273A
window.active.button.toggled.hover.image.color: #FF9A62
window.active.button.toggled.pressed.bg: flat solid
window.active.button.toggled.pressed.bg.color: #2B2230
window.active.button.toggled.pressed.image.color: #FF5E7E

window.active.button.disabled.bg: parentrelative
window.active.button.disabled.image.color: #3C4259

# --- Inactive Window ---
window.inactive.border.color: #252A3D
window.inactive.client.color: #0D0E15
window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #10121B
window.inactive.title.separator.color: #202436

window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #6E778C

window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #10121B
window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #2C3147

# Inactive Buttons
window.inactive.button.unpressed.bg: parentrelative
window.inactive.button.unpressed.image.color: #6E778C

window.inactive.button.hover.bg: flat solid
window.inactive.button.hover.bg.color: #1B1E2D
window.inactive.button.hover.image.color: #FF9A62
window.inactive.button.close.hover.bg: flat solid
window.inactive.button.close.hover.bg.color: #341A22
window.inactive.button.close.hover.image.color: #F25C6E

window.inactive.button.pressed.bg: flat solid
window.inactive.button.pressed.bg.color: #262A3D
window.inactive.button.pressed.image.color: #FF5E7E

window.inactive.button.toggled.unpressed.bg: parentrelative
window.inactive.button.toggled.unpressed.image.color: #6E778C
window.inactive.button.toggled.hover.bg: flat solid
window.inactive.button.toggled.hover.bg.color: #1B1E2D
window.inactive.button.toggled.hover.image.color: #FF9A62
window.inactive.button.toggled.pressed.bg: flat solid
window.inactive.button.toggled.pressed.bg.color: #262A3D
window.inactive.button.toggled.pressed.image.color: #FF5E7E

window.inactive.button.disabled.bg: parentrelative
window.inactive.button.disabled.image.color: #31364A

# --- Menus ---
menu.border.width: 1
menu.border.color: #3B425E
menu.overlap.x: -2
menu.overlap.y: 0

menu.title.bg: flat solid
menu.title.bg.color: #141621
menu.title.text.color: #FF9A62
menu.title.text.justify: center

menu.items.bg: flat solid
menu.items.bg.color: #1B1E2D
menu.items.text.color: #F5F6FA
menu.items.disabled.text.color: #6E778C

menu.items.active.bg: flat solid
menu.items.active.bg.color: #2B2230
menu.items.active.text.color: #FF9A62
menu.items.active.disabled.text.color: #6E778C

menu.separator.color: #2C3147
menu.separator.width: 1
menu.separator.padding.width: 6
menu.separator.padding.height: 4

# --- On-Screen Display (Alt+Tab / Workspace Switch) ---
osd.border.width: 1
osd.border.color: #FF5E7E
osd.bg: flat solid
osd.bg.color: #1B1E2D
osd.label.bg: parentrelative
osd.label.text.color: #F5F6FA
osd.hilight.bg: flat solid
osd.hilight.bg.color: #FF5E7E
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #2C3147
