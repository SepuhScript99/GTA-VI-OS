# GTA VI OS (Vice OS) Default System Locale
# This file is installed to /etc/default/locale
# It sets the system-wide language and character encoding.

# Set the default language and character encoding.
# LANG is the primary environment variable; other LC_* variables inherit from it.
LANG=en_US.UTF-8

# Explicitly set character classification to ensure UTF-8 support.
LC_CTYPE=en_US.UTF-8

# Set the language for message translations (falls back to LANG).
# Format: language[_territory][.codeset][@modifier]
LANGUAGE=en_US:en