<?xml version="1.0" encoding="UTF-8"?>
<actions>
  <action>
    <icon>utilities-terminal</icon>
    <name>Open Terminal Here</name>
    <unique-id>vice-os-open-terminal-here</unique-id>
    <command>xterm</command>
    <description>Open a terminal in the selected folder</description>
    <patterns>*</patterns>
    <startup-notify/>
    <directories/>
  </action>
  <action>
    <icon>document-open</icon>
    <name>Open as Root</name>
    <unique-id>vice-os-open-as-root</unique-id>
    <command>pkexec thunar %f</command>
    <description>Open the selected folder with administrative privileges</description>
    <patterns>*</patterns>
    <startup-notify/>
    <directories/>
  </action>
  <action>
    <icon>accessories-text-editor</icon>
    <name>Edit as Root</name>
    <unique-id>vice-os-edit-as-root</unique-id>
    <command>pkexec geany %f</command>
    <description>Edit the selected file with administrative privileges</description>
    <patterns>*</patterns>
    <startup-notify/>
    <text-files/>
  </action>
</actions>