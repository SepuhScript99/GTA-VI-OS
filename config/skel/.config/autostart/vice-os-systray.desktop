[Desktop Entry]
Type=Application
Name=Vice OS System Tray
Comment=Start the stalonetray system tray for applets (nm-applet, polkit)
Exec=stalonetray --dockapp-mode none --decorations none --geometry 1x1-0+0
Terminal=false
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=2
StartupNotify=false
Icon=preferences-system-notifications
Categories=Utility;