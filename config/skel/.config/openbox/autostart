#!/bin/sh
# GTA VI OS (Vice OS) Openbox Autostart Script
# Executed by openbox-session upon login.

# 1. Start Core UI Components explicitly to ensure proper ordering
if command -v picom >/dev/null 2>&1 && ! pgrep -u "$(id -u)" -x picom >/dev/null 2>&1; then
    PICOM_CONF="/etc/xdg/compton.conf"
    if [ -f /etc/xdg/picom.conf ]; then
        PICOM_CONF="/etc/xdg/picom.conf"
    fi
    if grep -qiE "llvmpipe|softpipe|No 3D acceleration" /var/log/Xorg.0.log "$HOME/.local/share/xorg/Xorg.0.log" 2>/dev/null || \
       (command -v glxinfo >/dev/null 2>&1 && glxinfo -B 2>/dev/null | grep -qiE "llvmpipe|softpipe|swrast"); then
        /usr/bin/picom -b --backend xrender --no-fading-openclose --config "$PICOM_CONF" >/dev/null 2>&1 &
    else
        /usr/bin/picom -b --config "$PICOM_CONF" >/dev/null 2>&1 &
    fi
fi

/usr/bin/feh --bg-fill /usr/share/backgrounds/vice_neon.jpg >/dev/null 2>&1 &

if command -v pcmanfm >/dev/null 2>&1 && ! pgrep -u "$(id -u)" -x pcmanfm >/dev/null 2>&1; then
    /usr/bin/pcmanfm --desktop --profile vice >/dev/null 2>&1 &
fi

if command -v xcape >/dev/null 2>&1 && ! pgrep -u "$(id -u)" -x xcape >/dev/null 2>&1; then
    /usr/bin/xcape -e 'Super_L=Alt_L|F1' >/dev/null 2>&1 &
fi

if ! pgrep -u "$(id -u)" -f "vice_shell.py" >/dev/null 2>&1; then
    /usr/bin/python3 /opt/vice-os/vice_shell.py >/dev/null 2>&1 &
fi

# 2. Export DBus environment if not already set (fallback for manual starts)
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ -x /usr/bin/dbus-launch ]; then
    eval "$(/usr/bin/dbus-launch --sh-syntax --exit-with-session)"
fi

# 2.2 Start Polkit GNOME authentication agent explicitly after DBus is ready
if [ -x /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1 ] && \
   ! pgrep -u "$(id -u)" -f "polkit-gnome-authentication-agent-1" >/dev/null 2>&1; then
    /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1 >/dev/null 2>&1 &
fi

# 2.5 Start the Vice notification daemon (owns org.freedesktop.Notifications).
#     Runs AFTER DBus export so the session bus is guaranteed available.
#     Exits gracefully if another notification daemon already owns the name.
if [ -x /opt/vice-os/vice_notification_daemon.py ] && \
   ! pgrep -u "$(id -u)" -f "vice_notification_daemon.py" >/dev/null 2>&1; then
    /usr/bin/python3 /opt/vice-os/vice_notification_daemon.py >/dev/null 2>&1 &
fi

# 2.6 Start the system notifier (battery/disk/temperature alerts via notify-send).
if [ -x /opt/vice-os/vice_system_notifier.py ] && \
   ! pgrep -u "$(id -u)" -f "vice_system_notifier.py" >/dev/null 2>&1; then
    /usr/bin/python3 /opt/vice-os/vice_system_notifier.py >/dev/null 2>&1 &
fi

# 2.8 Launch blueman-applet only if a tray (stalonetray) is present
if command -v blueman-applet >/dev/null 2>&1 && \
   ! pgrep -u "$(id -u)" -x blueman-applet >/dev/null 2>&1; then
    if command -v stalonetray >/dev/null 2>&1; then
        (
            w=0
            while [ "$w" -lt 15 ]; do
                if pgrep -u "$(id -u)" -x stalonetray >/dev/null 2>&1; then
                    blueman-applet >/dev/null 2>&1 &
                    break
                fi
                sleep 0.5
                w=$((w + 1))
            done
        ) &
    fi
fi

# 2.9 Trigger background host clock/timezone refresh once session starts (non-interactive only)
if [ -x /usr/local/bin/vice-timesync ] && command -v sudo >/dev/null 2>&1; then
    sudo -n /usr/local/bin/vice-timesync --auto >/dev/null 2>&1 &
fi

# 3. Execute XDG Autostart entries (System-wide + User-specific)
# We process user-specific entries first, then system-wide, ensuring
# user overrides take precedence and avoiding duplicate executions.

started_apps=""

process_autostart_dir() {
    dir="$1"
    if [ -d "$dir" ]; then
        for f in "$dir"/*.desktop; do
            if [ -f "$f" ]; then
                app_name=$(basename "$f")

                # Skip if already started (e.g., user override processed first)
                case " $started_apps " in
                    *" $app_name "*) continue ;;
                esac

                # Skip if Hidden=true
                if grep -q "^Hidden=true" "$f"; then
                    continue
                fi

                # Skip components started explicitly above (and nm-applet/blueman if no XEmbed tray is installed)
                case "$app_name" in
                    vice-os-compositor.desktop|vice-os-wallpaper.desktop|vice-os-shell.desktop|vice-os-notifications.desktop|polkit-gnome-authentication-agent-1.desktop|blueman.desktop|blueman-applet.desktop)
                        continue
                        ;;
                    pulseaudio.desktop)
                        if command -v pipewire >/dev/null 2>&1; then
                            continue
                        fi
                        ;;
                    nm-applet.desktop|print-applet.desktop)
                        if ! command -v stalonetray >/dev/null 2>&1; then
                            continue
                        fi
                        ;;
                esac

                # Check TryExec if specified
                try_exec=$(grep -m 1 "^TryExec=" "$f" | sed 's/^TryExec=//')
                if [ -n "$try_exec" ] && ! command -v "$try_exec" >/dev/null 2>&1; then
                    continue
                fi

                # Extract Exec line, remove %f, %u, etc.
                cmd=$(grep -m 1 "^Exec=" "$f" | sed 's/^Exec=//;s/ %.*//')
                if [ -n "$cmd" ]; then
                    eval "$cmd &" 2>/dev/null
                    started_apps="$started_apps $app_name"
                fi
            fi
        done
    fi
}

# Process user-specific autostart (takes precedence)
process_autostart_dir "$HOME/.config/autostart"

# Process system-wide autostart
process_autostart_dir "/etc/xdg/autostart"

exit 0
