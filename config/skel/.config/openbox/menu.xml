<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu xmlns="http://openbox.org/3.4/menu">
  <!-- GTA VI OS (Vice OS) Static Fallback Menu -->
  <!-- This menu is used if the dynamic pipe menu (ob_menu.py) fails. -->

  <menu id="root-menu" label="Vice OS">
    <item label="Applications Launcher">
      <action name="Execute"><command>python3 /opt/vice-os/vice_launcher.py</command></action>
    </item>
    <item label="Terminal">
      <action name="Execute"><command>xfce4-terminal</command></action>
    </item>
    <item label="File Manager">
      <action name="Execute"><command>thunar</command></action>
    </item>
    <item label="Web Browser">
      <action name="Execute"><command>firefox</command></action>
    </item>
    <separator />
    <item label="Vice OS Settings">
      <action name="Execute"><command>python3 /opt/vice-os/vice_settings.py</command></action>
    </item>
    <separator />
    <menu id="client-list-menu" />
    <separator />
    <item label="Show Desktop">
      <action name="ToggleShowDesktop" />
    </item>
    <item label="Restart Openbox">
      <action name="Reconfigure" />
    </item>
    <item label="Exit Openbox">
      <action name="Exit" />
    </item>
  </menu>
</openbox_menu>
