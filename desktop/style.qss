/* GTA VI OS (Vice OS) Global Qt Stylesheet v4.1 — Leonida Coastal Dusk (Win11 Rounded) */

/* --- Global Defaults --- */
QWidget {
    background-color: #0D0E15;
    color: #F5F6FA;
    font-family: "Noto Sans", "Noto Sans CJK JP", "Noto Sans CJK SC", "Noto Sans CJK TC", "Noto Sans CJK KR", "DejaVu Sans", sans-serif;
    font-size: 13px;
}

/* --- Standard Dialogs & Windows --- */
QDialog, QMessageBox {
    background-color: #141621;
    color: #F5F6FA;
    border-radius: 12px;
}

/* --- Desktop Shell: Bottom 44px Cinnamon-Style Taskbar --- */
QWidget#TopBar, QWidget#BottomTaskbar {
    background-color: rgba(13, 14, 21, 242);
    border-top: 1px solid #262A3D;
}

QPushButton#StartButton {
    background-color: #141621;
    color: #F5F6FA;
    border: 1px solid #262A3D;
    border-radius: 9px;
    padding: 2px 10px;
    font-weight: bold;
    font-size: 12px;
    min-width: 36px;
}

QPushButton#StartButton:hover {
    background-color: #1B1E2D;
    border: 1px solid #353B54;
    color: #F5F6FA;
}

QPushButton#StartButton:checked, QPushButton#StartButton:pressed {
    background-color: #2B2230;
    border: 1px solid #FF5E7E;
    color: #FF9A62;
}

QPushButton#PinButton {
    background-color: transparent;
    color: #A6AEBF;
    border: 1px solid transparent;
    border-radius: 9px;
    padding: 2px;
    min-width: 0px;
}

QPushButton#PinButton:hover {
    background-color: #1B1E2D;
    border: 1px solid #262A3D;
}

QPushButton#TaskButton {
    background-color: #141621;
    color: #A6AEBF;
    border: 1px solid #262A3D;
    border-radius: 9px;
    padding: 2px 6px;
    min-width: 0px;
    max-width: 230px;
    font-family: "Noto Sans", "Noto Sans CJK JP", "Noto Sans CJK SC", "Noto Sans CJK TC", "Noto Sans CJK KR", "DejaVu Sans", sans-serif;
    font-size: 12px;
    text-align: left;
}

QPushButton#TaskButton:hover {
    background-color: #1B1E2D;
    color: #F5F6FA;
    border: 1px solid #353B54;
}

QPushButton#TaskButton:checked {
    background-color: #1B1E2D;
    color: #F5F6FA;
    border: 1px solid #353B54;
    border-bottom: 2px solid #FF5E7E;
    font-weight: normal;
}

QPushButton#QuickUtilButton {
    background-color: #141621;
    color: #A6AEBF;
    border: 1px solid #262A3D;
    border-radius: 8px;
    padding: 2px 6px;
    min-width: 0px;
    font-size: 12px;
}

QPushButton#QuickUtilButton:hover {
    background-color: #1B1E2D;
    color: #F5F6FA;
    border: 1px solid #353B54;
}

QPushButton#BatteryButton {
    background-color: #122427;
    color: #36D6C3;
    border: 1px solid #224B4F;
    border-radius: 8px;
    padding: 2px 6px;
    min-width: 0px;
    font-size: 11px;
    font-weight: bold;
}

QPushButton#BatteryButton:hover {
    background-color: #1B1E2D;
    color: #F5F6FA;
    border: 1px solid #36D6C3;
}

QPushButton#VolumeMuteButton {
    background-color: #1B1E2D;
    color: #F5F6FA;
    border: 1px solid #353B54;
    border-radius: 9px;
    padding: 4px 12px;
    min-width: 68px;
    font-size: 12px;
    font-weight: bold;
}

QPushButton#VolumeMuteButton:hover {
    background-color: #23273A;
    color: #F5F6FA;
    border: 1px solid #FF9A62;
}

QPushButton#VolumeMuteButton:checked {
    background-color: #3B1D26;
    color: #F5F6FA;
    border: 1px solid #F25C6E;
}

QPushButton#ShowDesktopButton {
    background-color: #141621;
    color: #A6AEBF;
    border: 1px solid #262A3D;
    border-radius: 8px;
    padding: 2px;
    min-width: 24px;
    max-width: 28px;
}

QPushButton#ShowDesktopButton:hover {
    background-color: #1B1E2D;
    border: 1px solid #FF5E7E;
}

QPushButton#ShowDesktopButton:checked {
    background-color: #122427;
    border: 1px solid #36D6C3;
}

QPushButton#PowerButton {
    background-color: #2A161D;
    color: #F25C6E;
    border: 1px solid #592835;
    border-radius: 9px;
    padding: 3px 10px;
    min-width: 32px;
    font-weight: bold;
    font-size: 12px;
}

QPushButton#PowerButton:hover {
    background-color: #3B1D26;
    color: #F5F6FA;
    border: 1px solid #F25C6E;
}

/* --- Instant Mint Cinnamon-Style Start Menu & Volume Popups --- */
QWidget#StartMenuPopup, QWidget#VolumePopup {
    background-color: rgba(20, 22, 33, 248);
    border: 1px solid #353B54;
    border-radius: 14px;
}

QWidget#StartRail {
    background-color: rgba(13, 14, 21, 248);
    border-right: 1px solid #262A3D;
    border-top-left-radius: 13px;
    border-bottom-left-radius: 13px;
}

QPushButton#RailButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 9px;
    padding: 4px;
    min-width: 0px;
}

QPushButton#RailButton:hover {
    background-color: #1B1E2D;
    border: 1px solid #262A3D;
}

QPushButton#RailHubButton {
    background-color: #1B1E2D;
    border: 1px solid #353B54;
    border-radius: 9px;
    padding: 4px;
    min-width: 0px;
}

QPushButton#RailHubButton:hover {
    background-color: #2B2230;
    border: 1px solid #FF5E7E;
}

QPushButton#StartHubPill {
    background-color: #1B1E2D;
    color: #F7C873;
    border: 1px solid #353B54;
    border-radius: 9px;
    padding: 3px 10px;
    min-width: 0px;
    font-size: 11px;
    font-weight: bold;
}

QPushButton#StartHubPill:hover {
    background-color: #2B2230;
    color: #FF9A62;
    border: 1px solid #FF5E7E;
}

QListWidget#StartCatList {
    background-color: #0D0E15;
    border: 1px solid #262A3D;
    border-radius: 10px;
    padding: 4px;
    outline: none;
    font-family: "Noto Sans", "Noto Sans CJK JP", "Noto Sans CJK SC", "Noto Sans CJK TC", "Noto Sans CJK KR", "DejaVu Sans", sans-serif;
}

QListWidget#StartCatList::item {
    padding: 7px 10px;
    border-radius: 8px;
    color: #A6AEBF;
}

QListWidget#StartCatList::item:hover {
    background-color: #1B1E2D;
    color: #F5F6FA;
}

QListWidget#StartCatList::item:selected {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #FF5E7E, stop:1 #FF9A62);
    color: #0D0E15;
    font-weight: bold;
}

QListWidget#StartAppList {
    background-color: #141621;
    border: 1px solid #262A3D;
    border-radius: 10px;
    padding: 4px;
    outline: none;
    font-family: "Noto Sans", "Noto Sans CJK JP", "Noto Sans CJK SC", "Noto Sans CJK TC", "Noto Sans CJK KR", "DejaVu Sans", sans-serif;
}

QListWidget#StartAppList::item {
    padding: 7px 10px;
    border-radius: 8px;
    color: #F5F6FA;
}

QListWidget#StartAppList::item:hover {
    background-color: #1B1E2D;
    color: #F5F6FA;
}

QListWidget#StartAppList::item:selected {
    background-color: #2B2230;
    color: #FF9A62;
}

QWidget#Dock {
    background-color: rgba(20, 22, 33, 240);
    border: 1px solid #262A3D;
    border-radius: 14px;
}

QWidget#RunMenu {
    background-color: rgba(20, 22, 33, 248);
    border: 1px solid #353B54;
    border-radius: 12px;
}

/* --- Inputs & Text Edits --- */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QComboBox {
    background-color: #1B1E2D;
    color: #F5F6FA;
    border: 1px solid #262A3D;
    border-radius: 9px;
    padding: 6px 10px;
    selection-background-color: #4A2438;
    selection-color: #F5F6FA;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QComboBox:focus {
    border: 1px solid #FF5E7E;
    background-color: #1F2334;
}

/* --- Buttons (Standard) --- */
QPushButton {
    background-color: #1B1E2D;
    color: #F5F6FA;
    border: 1px solid #262A3D;
    border-radius: 9px;
    padding: 6px 14px;
    min-width: 56px;
}

QPushButton:hover {
    background-color: #23273A;
    color: #F5F6FA;
    border: 1px solid #353B54;
}

QPushButton:focus {
    border: 1px solid #FF5E7E;
    outline: none;
}

QPushButton:pressed {
    background-color: #2B3046;
    color: #F5F6FA;
    border: 1px solid #FF5E7E;
}

QPushButton:disabled {
    color: #6E778C;
    border-color: #1E2130;
    background-color: #11131C;
}

QPushButton#PrimaryButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #FF5E7E, stop:1 #FF9A62);
    color: #0D0E15;
    border: none;
    border-radius: 9px;
    padding: 7px 16px;
    font-weight: bold;
}

QPushButton#PrimaryButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #FF708D, stop:1 #FFA975);
}

/* --- Tool Buttons --- */
QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 4px 6px;
}

QToolButton:hover {
    background-color: #1B1E2D;
    border: 1px solid #353B54;
}

QToolButton:checked, QToolButton:pressed {
    background-color: #2B2230;
    border: 1px solid #FF5E7E;
}

/* --- Desktop Shell: Dock Button --- */
QPushButton#DockButton {
    background-color: #1B1E2D;
    color: #F5F6FA;
    border: 1px solid #262A3D;
    border-radius: 9px;
    padding: 6px 10px;
    font-weight: bold;
    font-size: 12px;
    min-width: 72px;
}

QPushButton#DockButton:hover {
    background-color: #23273A;
    color: #FF9A62;
    border: 1px solid #353B54;
}

QPushButton#DockButton:pressed {
    background-color: #FF5E7E;
    color: #0D0E15;
    border: 1px solid #FF9A62;
}

/* --- Legacy / Exit Button --- */
QPushButton#ExitButton {
    background-color: transparent;
    color: #F25C6E;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 3px 8px;
    min-width: 0px;
    font-weight: bold;
}

QPushButton#ExitButton:hover {
    color: #F5F6FA;
    border: 1px solid #F25C6E;
    background-color: #3B1D26;
}

/* --- Labels --- */
QLabel {
    background-color: transparent;
    border: none;
    color: #F5F6FA;
}

QPushButton#Clock, QLabel#Clock {
    background-color: transparent;
    color: #F5F6FA;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 1px 6px;
    min-width: 0px;
    font-weight: bold;
    font-size: 11px;
}

QPushButton#Clock:hover {
    background-color: #1B1E2D;
    color: #FF9A62;
    border: 1px solid #353B54;
}

QPushButton#SysInfo, QLabel#SysInfo {
    background-color: transparent;
    color: #A6AEBF;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 2px 6px;
    min-width: 0px;
    font-size: 11px;
}

QPushButton#SysInfo:hover {
    background-color: #1B1E2D;
    color: #F5F6FA;
    border: 1px solid #262A3D;
}

/* --- Dropdowns (ComboBox) --- */
QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox::down-arrow {
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 6px solid #A6AEBF;
    margin-left: 6px;
}

QComboBox QAbstractItemView {
    background-color: #1B1E2D;
    color: #F5F6FA;
    border: 1px solid #353B54;
    border-radius: 10px;
    outline: none;
    padding: 4px;
}

QComboBox QAbstractItemView::item {
    padding: 6px 10px;
    border-radius: 6px;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #2B2230;
    color: #FF9A62;
}

/* --- Checkboxes & Radios --- */
QCheckBox, QRadioButton {
    background-color: transparent;
    spacing: 8px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid #353B54;
    background-color: #1B1E2D;
    border-radius: 5px;
}

QCheckBox::indicator:focus, QRadioButton::indicator:focus {
    border: 1px solid #FF5E7E;
}

QRadioButton::indicator {
    border-radius: 8px;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #FF5E7E;
    border: 1px solid #FF5E7E;
}

/* --- Sliders --- */
QSlider::groove:horizontal {
    border: none;
    height: 5px;
    background: #1B1E2D;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #F5F6FA;
    border: 2px solid #FF5E7E;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 8px;
}

QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #FF5E7E, stop:1 #FF9A62);
    border-radius: 3px;
}

/* --- Group Boxes --- */
QGroupBox {
    background-color: #141621;
    border: 1px solid #262A3D;
    border-radius: 12px;
    margin-top: 12px;
    padding: 12px;
    color: #F5F6FA;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    color: #F7C873;
}

/* --- Toolbars & Status Bars --- */
QToolBar {
    background-color: #141621;
    border-bottom: 1px solid #262A3D;
}

QStatusBar {
    background-color: #141621;
    color: #A6AEBF;
    border-top: 1px solid #262A3D;
}

QStatusBar::item {
    border: none;
}

/* --- Dock Widgets --- */
QDockWidget::title {
    background-color: #1B1E2D;
    border: 1px solid #262A3D;
    border-radius: 8px;
    padding: 6px;
}

/* --- Tabs --- */
QTabWidget::pane {
    border: 1px solid #262A3D;
    background-color: #141621;
    border-radius: 12px;
}

QTabBar::tab {
    background-color: #141621;
    color: #A6AEBF;
    border: 1px solid #262A3D;
    padding: 8px 18px;
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    margin-right: 2px;
    font-weight: normal;
}

QTabBar::tab:hover {
    background-color: #1B1E2D;
    color: #F5F6FA;
}

QTabBar::tab:selected {
    background-color: #1B1E2D;
    border-color: #353B54;
    border-bottom: 2px solid #FF5E7E;
    color: #F5F6FA;
    font-weight: normal;
}

/* --- Progress Bars --- */
QProgressBar {
    text-align: center;
    background-color: #1B1E2D;
    border: 1px solid #262A3D;
    border-radius: 8px;
    color: #F5F6FA;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #FF5E7E, stop:1 #FF9A62);
    border-radius: 7px;
}

/* --- List, Tree, & Table Views --- */
QTreeView, QListView, QTableView, QListWidget {
    background-color: #141621;
    color: #F5F6FA;
    border: 1px solid #262A3D;
    border-radius: 10px;
    outline: none;
}

QTreeView::item, QListView::item, QTableView::item, QListWidget::item {
    padding: 6px 8px;
    border-radius: 8px;
}

QTreeView::item:alternate, QListView::item:alternate, QTableView::item:alternate {
    background-color: #171A26;
}

QTreeView::item:selected, QListView::item:selected, QTableView::item:selected, QListWidget::item:selected {
    background-color: #2B2230;
    color: #FF9A62;
}

QHeaderView::section {
    background-color: #1B1E2D;
    color: #A6AEBF;
    padding: 6px;
    border: 1px solid #262A3D;
    font-weight: bold;
}

/* --- Context Menus --- */
QMenu {
    background-color: #1B1E2D;
    border: 1px solid #353B54;
    border-radius: 12px;
    color: #F5F6FA;
    padding: 6px;
}

QMenu::item {
    background-color: transparent;
    padding: 6px 18px;
    border-radius: 8px;
}

QMenu::item:selected {
    background-color: #2B2230;
    color: #FF9A62;
}

QMenu::separator {
    height: 1px;
    background-color: #262A3D;
    margin: 5px 10px;
}

/* --- Tooltips --- */
QToolTip {
    background-color: #1B1E2D;
    color: #F5F6FA;
    border: 1px solid #353B54;
    border-radius: 9px;
    padding: 6px 10px;
}

/* --- Custom Scrollbars --- */
QScrollBar:vertical {
    border: none;
    background-color: transparent;
    width: 8px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: #2D3248;
    min-height: 24px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background-color: #FF5E7E;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background-color: transparent;
    height: 0;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background-color: transparent;
}

QScrollBar:horizontal {
    border: none;
    background-color: transparent;
    height: 8px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background-color: #2D3248;
    min-width: 24px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #FF5E7E;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    border: none;
    background-color: transparent;
    width: 0;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background-color: transparent;
}
