/* GTA VI OS (Vice OS) Global Qt Stylesheet v2.0 — Miami Dark Slate */

/* --- Global Defaults --- */
QWidget {
    background-color: #0f121d;
    color: #e8eef8;
    font-family: 'Noto Sans', 'DejaVu Sans', 'Sans';
    font-size: 13px;
}

/* --- Standard Dialogs & Windows --- */
QDialog, QMessageBox {
    background-color: #121624;
    color: #e8eef8;
}

/* --- Desktop Shell: Modern Translucent Panels --- */
QWidget#TopBar {
    background-color: rgba(13, 16, 27, 232);
    border-bottom: 1px solid rgba(0, 229, 255, 110);
}

QPushButton#AppsButton {
    background-color: rgba(24, 32, 52, 235);
    color: #00e5ff;
    border: 1px solid rgba(0, 229, 255, 160);
    border-radius: 8px;
    padding: 4px 12px;
    font-weight: bold;
    font-size: 12px;
    min-width: 68px;
}

QPushButton#AppsButton:hover {
    background-color: rgba(0, 229, 255, 45);
    color: #ffffff;
    border: 1px solid #00e5ff;
}

QPushButton#AppsButton:pressed {
    background-color: #00e5ff;
    color: #0f121d;
}

QPushButton#TaskButton {
    background-color: rgba(24, 30, 48, 210);
    color: #b7c3da;
    border: 1px solid rgba(56, 70, 105, 160);
    border-radius: 7px;
    padding: 3px 10px;
    min-width: 90px;
    max-width: 175px;
    font-size: 12px;
    text-align: left;
}

QPushButton#TaskButton:hover {
    background-color: rgba(34, 44, 70, 235);
    color: #ffffff;
    border: 1px solid rgba(0, 229, 255, 180);
}

QPushButton#TaskButton:checked {
    background-color: rgba(20, 46, 70, 240);
    color: #00e5ff;
    border: 1px solid #00e5ff;
    border-bottom: 2px solid #00e5ff;
    font-weight: bold;
}

QPushButton#QuickUtilButton {
    background-color: rgba(22, 28, 45, 180);
    color: #c8d3e6;
    border: 1px solid rgba(52, 64, 96, 130);
    border-radius: 7px;
    padding: 3px 9px;
    min-width: 0px;
    font-size: 12px;
}

QPushButton#QuickUtilButton:hover {
    background-color: rgba(32, 42, 68, 230);
    color: #00e5ff;
    border: 1px solid #00e5ff;
}

QPushButton#PowerButton {
    background-color: rgba(40, 20, 46, 200);
    color: #ff6eb4;
    border: 1px solid rgba(255, 46, 151, 140);
    border-radius: 7px;
    padding: 3px 10px;
    min-width: 58px;
    font-weight: bold;
    font-size: 12px;
}

QPushButton#PowerButton:hover {
    background-color: rgba(255, 46, 151, 60);
    color: #ffffff;
    border: 1px solid #ff2e97;
}

QWidget#Dock {
    background-color: rgba(15, 18, 29, 228);
    border: 1px solid rgba(255, 46, 151, 130);
    border-radius: 14px;
}

QWidget#RunMenu {
    background-color: rgba(16, 20, 34, 242);
    border: 1px solid #00e5ff;
    border-radius: 12px;
}

/* --- Inputs & Text Edits --- */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QComboBox {
    background-color: #161b2a;
    color: #e8eef8;
    border: 1px solid #2b3552;
    border-radius: 8px;
    padding: 6px 10px;
    selection-background-color: #1f4b66;
    selection-color: #ffffff;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QComboBox:focus {
    border: 1px solid #00e5ff;
    background-color: #1b2236;
}

/* --- Buttons (Standard) --- */
QPushButton {
    background-color: #1a2033;
    color: #e8eef8;
    border: 1px solid #2e3957;
    border-radius: 8px;
    padding: 6px 14px;
    min-width: 60px;
}

QPushButton:hover {
    background-color: #232c45;
    color: #00e5ff;
    border: 1px solid #00e5ff;
}

QPushButton:pressed {
    background-color: #00e5ff;
    color: #0f121d;
    border: 1px solid #00e5ff;
}

QPushButton:disabled {
    color: #5b6682;
    border-color: #22293d;
    background-color: #121624;
}

/* --- Tool Buttons --- */
QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px 6px;
}

QToolButton:hover {
    background-color: #1e2538;
    border: 1px solid #00e5ff;
}

QToolButton:checked, QToolButton:pressed {
    background-color: #1b324a;
    border: 1px solid #00e5ff;
}

/* --- Desktop Shell: Dock Button --- */
QPushButton#DockButton {
    background-color: rgba(24, 30, 48, 220);
    color: #e8eef8;
    border: 1px solid rgba(64, 78, 115, 160);
    border-radius: 10px;
    padding: 6px 10px;
    font-weight: bold;
    font-size: 12px;
    min-width: 72px;
}

QPushButton#DockButton:hover {
    background-color: rgba(28, 52, 78, 240);
    color: #00e5ff;
    border: 1px solid #00e5ff;
}

QPushButton#DockButton:pressed {
    background-color: #ff2e97;
    color: #ffffff;
    border: 1px solid #ffffff;
}

/* --- Desktop Shell: TopBar Exit / Legacy Button --- */
QPushButton#ExitButton {
    background-color: transparent;
    color: #ff6eb4;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 3px 8px;
    min-width: 0px;
    font-weight: bold;
}

QPushButton#ExitButton:hover {
    color: #ff3b6b;
    border: 1px solid #ff3b6b;
    background-color: rgba(255, 59, 107, 40);
}

/* --- Labels --- */
QLabel {
    background-color: transparent;
    border: none;
    color: #e8eef8;
}

QPushButton#Clock, QLabel#Clock {
    background-color: transparent;
    color: #00e5ff;
    border: 1px solid transparent;
    border-radius: 7px;
    padding: 3px 8px;
    min-width: 0px;
    font-weight: bold;
    font-size: 12px;
}

QPushButton#Clock:hover {
    background-color: rgba(24, 32, 52, 220);
    border: 1px solid rgba(0, 229, 255, 140);
}

QPushButton#SysInfo, QLabel#SysInfo {
    background-color: transparent;
    color: #9aa7c4;
    border: 1px solid transparent;
    border-radius: 7px;
    padding: 3px 8px;
    min-width: 0px;
    font-size: 12px;
}

QPushButton#SysInfo:hover {
    background-color: rgba(24, 32, 52, 220);
    color: #e8eef8;
    border: 1px solid rgba(56, 70, 105, 180);
}

/* --- Dropdowns (ComboBox) --- */
QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox::down-arrow {
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 6px solid #00e5ff;
    margin-left: 6px;
}

QComboBox QAbstractItemView {
    background-color: #151a2b;
    color: #e8eef8;
    border: 1px solid #2e3957;
    outline: none;
    padding: 4px;
}

QComboBox QAbstractItemView::item {
    padding: 6px 10px;
    border-radius: 4px;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #1d2d4a;
    color: #00e5ff;
}

/* --- Checkboxes & Radios --- */
QCheckBox, QRadioButton {
    background-color: transparent;
    spacing: 8px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid #3c486b;
    background-color: #161b2a;
    border-radius: 4px;
}

QCheckBox::indicator:focus, QRadioButton::indicator:focus {
    border: 1px solid #00e5ff;
}

QRadioButton::indicator {
    border-radius: 8px;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #00e5ff;
    border: 1px solid #00e5ff;
}

/* --- Sliders --- */
QSlider::groove:horizontal {
    border: 1px solid #262e45;
    height: 5px;
    background: #161b2a;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #00e5ff;
    border: 2px solid #0f121d;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

QSlider::sub-page:horizontal {
    background: #ff2e97;
    border-radius: 3px;
}

/* --- Group Boxes --- */
QGroupBox {
    background-color: #131826;
    border: 1px solid #252e47;
    border-radius: 10px;
    margin-top: 12px;
    padding: 12px;
    color: #e8eef8;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    color: #00e5ff;
}

/* --- Toolbars & Status Bars --- */
QToolBar {
    background-color: #131826;
    border-bottom: 1px solid #222a40;
}

QStatusBar {
    background-color: #131826;
    color: #9aa7c4;
    border-top: 1px solid #222a40;
}

QStatusBar::item {
    border: none;
}

/* --- Dock Widgets --- */
QDockWidget::title {
    background-color: #161b2a;
    border: 1px solid #252e47;
    padding: 6px;
}

/* --- Tabs --- */
QTabWidget::pane {
    border: 1px solid #252e47;
    background-color: #121624;
    border-radius: 8px;
}

QTabBar::tab {
    background-color: #161b2a;
    color: #9aa7c4;
    border: 1px solid #252e47;
    padding: 7px 14px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 2px;
}

QTabBar::tab:hover {
    background-color: #1e2538;
    color: #e8eef8;
}

QTabBar::tab:selected {
    background-color: #1b2d45;
    border-color: #00e5ff;
    color: #00e5ff;
    font-weight: bold;
}

/* --- Progress Bars --- */
QProgressBar {
    text-align: center;
    background-color: #161b2a;
    border: 1px solid #2b3552;
    border-radius: 6px;
    color: #e8eef8;
}

QProgressBar::chunk {
    background-color: #00e5ff;
    border-radius: 5px;
}

/* --- List, Tree, & Table Views --- */
QTreeView, QListView, QTableView, QListWidget {
    background-color: #121624;
    color: #e8eef8;
    border: 1px solid #252e47;
    border-radius: 8px;
    outline: none;
}

QTreeView::item, QListView::item, QTableView::item, QListWidget::item {
    padding: 6px 8px;
    border-radius: 4px;
}

QTreeView::item:alternate, QListView::item:alternate, QTableView::item:alternate {
    background-color: #151a2a;
}

QTreeView::item:selected, QListView::item:selected, QTableView::item:selected, QListWidget::item:selected {
    background-color: #1d3450;
    color: #00e5ff;
}

QHeaderView::section {
    background-color: #181f32;
    color: #00e5ff;
    padding: 6px;
    border: 1px solid #222a40;
    font-weight: bold;
}

/* --- Context Menus --- */
QMenu {
    background-color: #141928;
    border: 1px solid #2c3754;
    border-radius: 8px;
    color: #e8eef8;
    padding: 6px;
}

QMenu::item {
    background-color: transparent;
    padding: 6px 18px;
    border-radius: 5px;
}

QMenu::item:selected {
    background-color: #1f3352;
    color: #00e5ff;
}

QMenu::separator {
    height: 1px;
    background-color: #252e47;
    margin: 5px 10px;
}

/* --- Tooltips --- */
QToolTip {
    background-color: #151a2b;
    color: #e8eef8;
    border: 1px solid #00e5ff;
    border-radius: 6px;
    padding: 6px 8px;
}

/* --- Custom Scrollbars --- */
QScrollBar:vertical {
    border: none;
    background-color: transparent;
    width: 8px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: #2e3957;
    min-height: 24px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background-color: #00e5ff;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background-color: transparent;
    height: 0;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background-color: transparent;
}

QScrollBar:horizontal {
    border: none;
    background-color: transparent;
    height: 8px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background-color: #2e3957;
    min-width: 24px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #00e5ff;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    border: none;
    background-color: transparent;
    width: 0;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background-color: transparent;
}
