/* GTA VI OS (Vice OS) Global Qt Stylesheet v3.0 — Leonida Vice City Dark Palette */

/* --- Global Defaults --- */
QWidget {
    background-color: #120e1e;
    color: #f4f1fa;
    font-family: "Noto Sans", "Noto Sans CJK JP", "Noto Sans CJK SC", "Noto Sans CJK TC", "Noto Sans CJK KR", "DejaVu Sans", sans-serif;
    font-size: 13px;
}

/* --- Standard Dialogs & Windows --- */
QDialog, QMessageBox {
    background-color: #171226;
    color: #f4f1fa;
}

/* --- Desktop Shell: Bottom Cinnamon-Style Taskbar --- */
QWidget#TopBar, QWidget#BottomTaskbar {
    background-color: rgba(18, 14, 30, 240);
    border-top: 1px solid rgba(255, 77, 166, 150);
}

QPushButton#StartButton {
    background-color: rgba(34, 24, 58, 235);
    color: #ffffff;
    border: 1px solid rgba(255, 77, 166, 170);
    border-radius: 9px;
    padding: 2px 10px;
    font-weight: bold;
    font-size: 12px;
    min-width: 36px;
}

QPushButton#StartButton:hover {
    background-color: rgba(255, 77, 166, 65);
    border: 1px solid #ff8a5b;
}

QPushButton#StartButton:checked, QPushButton#StartButton:pressed {
    background-color: rgba(255, 77, 166, 110);
    border: 1px solid #ff4da6;
}

QPushButton#PinButton {
    background-color: transparent;
    color: #d6cee8;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 2px;
    min-width: 0px;
}

QPushButton#PinButton:hover {
    background-color: rgba(48, 36, 78, 220);
    border: 1px solid rgba(255, 138, 91, 170);
}

QPushButton#TaskButton {
    background-color: rgba(28, 22, 48, 215);
    color: #cfc6e6;
    border: 1px solid rgba(68, 52, 102, 165);
    border-radius: 8px;
    padding: 2px 10px;
    min-width: 56px;
    max-width: 230px;
    font-family: "Noto Sans", "Noto Sans CJK JP", "Noto Sans CJK SC", "Noto Sans CJK TC", "Noto Sans CJK KR", "DejaVu Sans", sans-serif;
    font-size: 12px;
    text-align: left;
}

QPushButton#TaskButton:hover {
    background-color: rgba(45, 34, 72, 235);
    color: #ffffff;
    border: 1px solid rgba(255, 138, 91, 185);
}

QPushButton#TaskButton:checked {
    background-color: rgba(58, 32, 74, 242);
    color: #ffffff;
    border: 1px solid #ff4da6;
    border-bottom: 2px solid #ff8a5b;
    font-weight: bold;
}

QPushButton#QuickUtilButton {
    background-color: rgba(28, 22, 48, 195);
    color: #d6cee8;
    border: 1px solid rgba(62, 48, 94, 145);
    border-radius: 8px;
    padding: 2px 8px;
    min-width: 0px;
    font-size: 12px;
}

QPushButton#QuickUtilButton:hover {
    background-color: rgba(46, 35, 74, 235);
    color: #ff8a5b;
    border: 1px solid #ff4da6;
}

QPushButton#BatteryButton {
    background-color: rgba(28, 22, 48, 195);
    color: #00e5c3;
    border: 1px solid rgba(0, 229, 195, 125);
    border-radius: 8px;
    padding: 2px 8px;
    min-width: 0px;
    font-size: 11px;
    font-weight: bold;
}

QPushButton#BatteryButton:hover {
    background-color: rgba(46, 35, 74, 235);
    color: #ffffff;
    border: 1px solid #ff4da6;
}

QPushButton#VolumeMuteButton {
    background-color: #261d40;
    color: #f4f1fa;
    border: 1px solid #5c488a;
    border-radius: 8px;
    padding: 4px 12px;
    min-width: 68px;
    font-size: 12px;
    font-weight: bold;
}

QPushButton#VolumeMuteButton:hover {
    background-color: #342757;
    color: #ffffff;
    border: 1px solid #ff8a5b;
}

QPushButton#VolumeMuteButton:checked {
    background-color: #c92a57;
    color: #ffffff;
    border: 1px solid #ff4da6;
}

QPushButton#ShowDesktopButton {
    background-color: rgba(34, 26, 56, 200);
    color: #cfc6e6;
    border: 1px solid rgba(78, 60, 118, 175);
    border-radius: 7px;
    padding: 2px;
    min-width: 24px;
    max-width: 28px;
}

QPushButton#ShowDesktopButton:hover {
    background-color: rgba(255, 77, 166, 80);
    border: 1px solid #ff4da6;
}

QPushButton#ShowDesktopButton:checked {
    background-color: rgba(0, 229, 195, 65);
    border: 1px solid #00e5c3;
}

QPushButton#PowerButton {
    background-color: rgba(52, 24, 52, 210);
    color: #ff77b7;
    border: 1px solid rgba(255, 77, 166, 160);
    border-radius: 8px;
    padding: 3px 10px;
    min-width: 32px;
    font-weight: bold;
    font-size: 12px;
}

QPushButton#PowerButton:hover {
    background-color: rgba(255, 77, 166, 80);
    color: #ffffff;
    border: 1px solid #ff8a5b;
}

/* --- Instant Mint Cinnamon-Style Start Menu Popup --- */
QWidget#StartMenuPopup, QWidget#VolumePopup {
    background-color: rgba(20, 15, 34, 246);
    border: 1px solid #ff4da6;
    border-radius: 14px;
}

QWidget#StartRail {
    background-color: rgba(14, 10, 26, 240);
    border-right: 1px solid #2e2348;
    border-top-left-radius: 13px;
    border-bottom-left-radius: 13px;
}

QPushButton#RailButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 9px;
    padding: 4px;
    min-width: 0px;
}

QPushButton#RailButton:hover {
    background-color: rgba(54, 34, 71, 225);
    border: 1px solid rgba(255, 77, 166, 180);
}

QPushButton#RailHubButton {
    background-color: rgba(24, 32, 54, 230);
    border: 1px solid rgba(0, 229, 195, 160);
    border-radius: 9px;
    padding: 4px;
    min-width: 0px;
}

QPushButton#RailHubButton:hover {
    background-color: rgba(54, 34, 71, 235);
    border: 1px solid #ff8a5b;
}

QPushButton#StartHubPill {
    background-color: rgba(24, 32, 54, 235);
    color: #00e5c3;
    border: 1px solid rgba(0, 229, 195, 170);
    border-radius: 8px;
    padding: 3px 10px;
    min-width: 0px;
    font-size: 11px;
    font-weight: bold;
}

QPushButton#StartHubPill:hover {
    background-color: rgba(54, 34, 71, 240);
    color: #ff8a5b;
    border: 1px solid #ff4da6;
}

QListWidget#StartCatList {
    background-color: rgba(16, 12, 28, 220);
    border: 1px solid #2a2042;
    border-radius: 10px;
    padding: 4px;
    outline: none;
    font-family: "Noto Sans", "Noto Sans CJK JP", "Noto Sans CJK SC", "Noto Sans CJK TC", "Noto Sans CJK KR", "DejaVu Sans", sans-serif;
}

QListWidget#StartCatList::item {
    padding: 7px 10px;
    border-radius: 7px;
    color: #d6cee8;
}

QListWidget#StartCatList::item:hover {
    background-color: #271e40;
    color: #ffffff;
}

QListWidget#StartCatList::item:selected {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #c8327e, stop:1 #e86b58);
    color: #ffffff;
    font-weight: bold;
}

QListWidget#StartAppList {
    background-color: rgba(22, 17, 38, 210);
    border: 1px solid #2a2042;
    border-radius: 10px;
    padding: 4px;
    outline: none;
    font-family: "Noto Sans", "Noto Sans CJK JP", "Noto Sans CJK SC", "Noto Sans CJK TC", "Noto Sans CJK KR", "DejaVu Sans", sans-serif;
}

QListWidget#StartAppList::item {
    padding: 7px 10px;
    border-radius: 7px;
    color: #f4f1fa;
}

QListWidget#StartAppList::item:hover {
    background-color: #2e224a;
    color: #ff8a5b;
}

QListWidget#StartAppList::item:selected {
    background-color: #3a2657;
    color: #ff8a5b;
}

QWidget#Dock {
    background-color: rgba(20, 15, 34, 232);
    border: 1px solid rgba(255, 77, 166, 145);
    border-radius: 14px;
}

QWidget#RunMenu {
    background-color: rgba(20, 15, 34, 245);
    border: 1px solid #ff4da6;
    border-radius: 12px;
}

/* --- Inputs & Text Edits --- */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QComboBox {
    background-color: #1b152e;
    color: #f4f1fa;
    border: 1px solid #352852;
    border-radius: 8px;
    padding: 6px 10px;
    selection-background-color: #6b2458;
    selection-color: #ffffff;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QComboBox:focus {
    border: 1px solid #ff4da6;
    background-color: #231b3b;
}

/* --- Buttons (Standard) --- */
QPushButton {
    background-color: #1d1733;
    color: #f4f1fa;
    border: 1px solid #382b57;
    border-radius: 8px;
    padding: 6px 14px;
    min-width: 60px;
}

QPushButton:hover {
    background-color: #2b2147;
    color: #ff8a5b;
    border: 1px solid #ff4da6;
}

QPushButton:pressed {
    background-color: #ff4da6;
    color: #120e1e;
    border: 1px solid #ff8a5b;
}

QPushButton:disabled {
    color: #6b6187;
    border-color: #261e3d;
    background-color: #151024;
}

/* --- Tool Buttons --- */
QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px 6px;
}

QToolButton:hover {
    background-color: #241c3d;
    border: 1px solid #ff4da6;
}

QToolButton:checked, QToolButton:pressed {
    background-color: #362247;
    border: 1px solid #ff4da6;
}

/* --- Desktop Shell: Dock Button --- */
QPushButton#DockButton {
    background-color: rgba(30, 23, 50, 225);
    color: #f4f1fa;
    border: 1px solid rgba(76, 58, 114, 165);
    border-radius: 10px;
    padding: 6px 10px;
    font-weight: bold;
    font-size: 12px;
    min-width: 72px;
}

QPushButton#DockButton:hover {
    background-color: rgba(54, 34, 71, 240);
    color: #ff8a5b;
    border: 1px solid #ff4da6;
}

QPushButton#DockButton:pressed {
    background-color: #ff4da6;
    color: #ffffff;
    border: 1px solid #ffffff;
}

/* --- Legacy / Exit Button --- */
QPushButton#ExitButton {
    background-color: transparent;
    color: #ff77b7;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 3px 8px;
    min-width: 0px;
    font-weight: bold;
}

QPushButton#ExitButton:hover {
    color: #ff3b6b;
    border: 1px solid #ff3b6b;
    background-color: rgba(255, 59, 107, 45);
}

/* --- Labels --- */
QLabel {
    background-color: transparent;
    border: none;
    color: #f4f1fa;
}

QPushButton#Clock, QLabel#Clock {
    background-color: transparent;
    color: #f4f1fa;
    border: 1px solid transparent;
    border-radius: 7px;
    padding: 1px 8px;
    min-width: 0px;
    font-weight: bold;
    font-size: 11px;
}

QPushButton#Clock:hover {
    background-color: rgba(45, 34, 72, 220);
    color: #ff8a5b;
    border: 1px solid rgba(255, 77, 166, 150);
}

QPushButton#SysInfo, QLabel#SysInfo {
    background-color: transparent;
    color: #cfc6e6;
    border: 1px solid transparent;
    border-radius: 7px;
    padding: 2px 8px;
    min-width: 0px;
    font-size: 11px;
}

QPushButton#SysInfo:hover {
    background-color: rgba(45, 34, 72, 220);
    color: #ffffff;
    border: 1px solid rgba(90, 70, 130, 180);
}

/* --- Dropdowns (ComboBox) --- */
QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox::down-arrow {
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 6px solid #ff4da6;
    margin-left: 6px;
}

QComboBox QAbstractItemView {
    background-color: #181229;
    color: #f4f1fa;
    border: 1px solid #382b57;
    outline: none;
    padding: 4px;
}

QComboBox QAbstractItemView::item {
    padding: 6px 10px;
    border-radius: 4px;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #362247;
    color: #ff8a5b;
}

/* --- Checkboxes & Radios --- */
QCheckBox, QRadioButton {
    background-color: transparent;
    spacing: 8px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid #4d3c73;
    background-color: #1b152e;
    border-radius: 4px;
}

QCheckBox::indicator:focus, QRadioButton::indicator:focus {
    border: 1px solid #ff4da6;
}

QRadioButton::indicator {
    border-radius: 8px;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #ff4da6;
    border: 1px solid #ff4da6;
}

/* --- Sliders --- */
QSlider::groove:horizontal {
    border: 1px solid #30244a;
    height: 5px;
    background: #1b152e;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #ff8a5b;
    border: 2px solid #120e1e;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

QSlider::sub-page:horizontal {
    background: #ff4da6;
    border-radius: 3px;
}

/* --- Group Boxes --- */
QGroupBox {
    background-color: #171226;
    border: 1px solid #30244a;
    border-radius: 10px;
    margin-top: 12px;
    padding: 12px;
    color: #f4f1fa;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    color: #ff8a5b;
}

/* --- Toolbars & Status Bars --- */
QToolBar {
    background-color: #171226;
    border-bottom: 1px solid #2e2348;
}

QStatusBar {
    background-color: #171226;
    color: #b7aed1;
    border-top: 1px solid #2e2348;
}

QStatusBar::item {
    border: none;
}

/* --- Dock Widgets --- */
QDockWidget::title {
    background-color: #1b152e;
    border: 1px solid #30244a;
    padding: 6px;
}

/* --- Tabs --- */
QTabWidget::pane {
    border: 1px solid #30244a;
    background-color: #161124;
    border-radius: 8px;
}

QTabBar::tab {
    background-color: #1b152e;
    color: #b7aed1;
    border: 1px solid #30244a;
    padding: 7px 14px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 2px;
}

QTabBar::tab:hover {
    background-color: #241c3d;
    color: #f4f1fa;
}

QTabBar::tab:selected {
    background-color: #362247;
    border-color: #ff4da6;
    color: #ff8a5b;
    font-weight: bold;
}

/* --- Progress Bars --- */
QProgressBar {
    text-align: center;
    background-color: #1b152e;
    border: 1px solid #352852;
    border-radius: 6px;
    color: #f4f1fa;
}

QProgressBar::chunk {
    background-color: #ff4da6;
    border-radius: 5px;
}

/* --- List, Tree, & Table Views --- */
QTreeView, QListView, QTableView, QListWidget {
    background-color: #161124;
    color: #f4f1fa;
    border: 1px solid #30244a;
    border-radius: 8px;
    outline: none;
}

QTreeView::item, QListView::item, QTableView::item, QListWidget::item {
    padding: 6px 8px;
    border-radius: 4px;
}

QTreeView::item:alternate, QListView::item:alternate, QTableView::item:alternate {
    background-color: #1a142d;
}

QTreeView::item:selected, QListView::item:selected, QTableView::item:selected, QListWidget::item:selected {
    background-color: #362247;
    color: #ff8a5b;
}

QHeaderView::section {
    background-color: #211a36;
    color: #ff8a5b;
    padding: 6px;
    border: 1px solid #2e2348;
    font-weight: bold;
}

/* --- Context Menus --- */
QMenu {
    background-color: #181229;
    border: 1px solid #382b57;
    border-radius: 8px;
    color: #f4f1fa;
    padding: 6px;
}

QMenu::item {
    background-color: transparent;
    padding: 6px 18px;
    border-radius: 5px;
}

QMenu::item:selected {
    background-color: #362247;
    color: #ff8a5b;
}

QMenu::separator {
    height: 1px;
    background-color: #2e2348;
    margin: 5px 10px;
}

/* --- Tooltips --- */
QToolTip {
    background-color: #181229;
    color: #f4f1fa;
    border: 1px solid #ff4da6;
    border-radius: 6px;
    padding: 6px 8px;
}

/* --- Custom Scrollbars --- */
QScrollBar:vertical {
    border: none;
    background-color: transparent;
    width: 8px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: #3a2c59;
    min-height: 24px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background-color: #ff4da6;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background-color: transparent;
    height: 0;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background-color: transparent;
}

QScrollBar:horizontal {
    border: none;
    background-color: transparent;
    height: 8px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background-color: #3a2c59;
    min-width: 24px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #ff4da6;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    border: none;
    background-color: transparent;
    width: 0;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background-color: transparent;
}
