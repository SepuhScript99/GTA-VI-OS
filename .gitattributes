# GTA VI OS (Vice OS) Git Attributes
# Enforces LF line endings for all text files to prevent cross-platform issues.

* text=auto eol=lf

# Explicitly enforce LF for scripts and configs
*.sh text eol=lf
*.py text eol=lf
*.desktop text eol=lf
*.xml text eol=lf
*.qss text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.list text eol=lf
*.conf text eol=lf
*.cfg text eol=lf
*.rules text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.json text eol=lf
*.css text eol=lf
*.ini text eol=lf

# Explicitly mark binary files
*.png binary
*.jpg binary
*.jpeg binary
*.iso binary
*.img binary
*.squashfs binary